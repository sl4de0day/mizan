# Sunucu Portu (Varsayılan: 8000)
PORT=8000

# Admin Paneli Erişim Belirteci (/api/admin/* uçları için zorunludur)
ADMIN_TOKEN=your_secure_admin_token_here

# Google Gemini API Anahtarı (Haber özetleme ve yapay zekâ modülleri için opsiyonel)
GEMINI_API_KEY=your_gemini_api_key_here

# Depolama Dizini (Varsayılan: backend-node/storage)
# STORAGE_DIR=storage
